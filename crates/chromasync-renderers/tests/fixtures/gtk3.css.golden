@define-color theme_bg_color #161B22;
@define-color theme_fg_color #F5F7FA;
@define-color theme_base_color #0F1115;
@define-color theme_text_color #F5F7FA;
@define-color theme_selected_bg_color #1F5F66;
@define-color theme_selected_fg_color #F5F7FA;
@define-color insensitive_bg_color #161B22;
@define-color insensitive_fg_color #B4BEC9;
@define-color insensitive_base_color #0F1115;
@define-color theme_unfocused_bg_color #161B22;
@define-color theme_unfocused_fg_color #B4BEC9;
@define-color theme_unfocused_base_color #0F1115;
@define-color theme_unfocused_text_color #B4BEC9;
@define-color theme_unfocused_selected_bg_color #252D38;
@define-color theme_unfocused_selected_fg_color #F5F7FA;
@define-color borders #2F3947;
@define-color unfocused_borders #2F3947;
@define-color warning_color #F4A261;
@define-color error_color #E76F51;
@define-color success_color #57CC99;
@define-color link_color #7CC6FF;
@define-color titlebar_bg_color #1D232C;
@define-color titlebar_fg_color #F5F7FA;
@define-color theme_titlebar_bg_color #1D232C;
@define-color theme_titlebar_fg_color #F5F7FA;
@define-color menubar_bg_color #161B22;
@define-color menubar_fg_color #F5F7FA;
@define-color toolbar_bg_color #1D232C;
@define-color toolbar_fg_color #F5F7FA;
@define-color sidebar_bg_color #1D232C;
@define-color sidebar_fg_color #F5F7FA;
@define-color content_view_bg #0F1115;
@define-color text_view_bg #0F1115;
@define-color terminal_bg_color #0F1115;
@define-color terminal_fg_color #F5F7FA;
@define-color theme_button_background_normal #1D232C;
@define-color theme_button_foreground_normal #F5F7FA;
@define-color theme_button_background_hover #252D38;
@define-color theme_entry_background #161B22;
@define-color theme_entry_foreground #F5F7FA;

.background,
window,
dialog,
popover,
menu {
  background-color: @theme_bg_color;
  color: @theme_fg_color;
}

dialog,
dialog.background {
  background-color: #252D38;
  color: @theme_fg_color;
}

popover,
popover.background,
menu,
menubar,
context-menu {
  background-color: #252D38;
  color: @theme_fg_color;
  border-color: #445264;
}

/* Popover model buttons use their own CSS node, not the button rules. */
modelbutton,
menuitem {
  background-color: transparent;
  background-image: none;
  color: @theme_fg_color;
  text-shadow: none;
  -gtk-icon-shadow: none;
  box-shadow: none;
}

modelbutton label,
modelbutton image,
menuitem label,
menuitem image {
  color: inherit;
}

modelbutton:hover:not(:disabled),
modelbutton:focus:not(:disabled),
modelbutton:active:not(:disabled),
menuitem:hover:not(:disabled),
menuitem:selected:not(:disabled) {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

modelbutton:disabled,
menuitem:disabled {
  color: @insensitive_fg_color;
}

tooltip,
tooltip.background {
  background-color: #252D38;
  color: @theme_fg_color;
  border-color: #445264;
  text-shadow: none;
}

tooltip label {
  color: inherit;
}

headerbar,
.titlebar,
toolbar,
searchbar,
searchbar > revealer > box,
actionbar > revealer > box,
GtkHeaderBar,
GtkToolbar,
.searchbar-container,
GtkSearchBar {
  background-color: @titlebar_bg_color;
  background-image: none;
  color: @titlebar_fg_color;
  border-color: #445264;
}

.searchbar-container.inline,
GtkSearchBar.inline {
  background-color: @theme_base_color;
  color: @theme_text_color;
  border-color: @borders;
}

NautilusWindow .sidebar,
NemoWindow .sidebar,
.sidebar,
GtkPlacesSidebar,
placessidebar {
  background-color: @sidebar_bg_color;
  color: @sidebar_fg_color;
  border-color: #445264;
}

textview,
textview text,
textview border,
treeview,
iconview,
flowbox,
.view,
.content-view,
NautilusWindow .view {
  background-color: @theme_base_color;
  color: @theme_text_color;
  border-color: @borders;
}

/* List boxes and their rows have their own foreground in the base theme. */
list {
  background-color: @theme_base_color;
  color: @theme_text_color;
}

list > row {
  color: inherit;
}

list > row.activatable:hover {
  background-color: #252D38;
}

flowboxchild:selected,
flowboxchild:selected:hover,
list > row:selected,
list > row:selected:hover,
treeview.view:selected,
iconview.view:selected {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

list > row:disabled,
list > row label:disabled,
list > row image:disabled {
  color: @insensitive_fg_color;
}

entry,
GtkEntry,
searchentry {
  background-color: @theme_entry_background;
  background-image: none;
  color: @theme_entry_foreground;
  border-color: @borders;
  caret-color: #4ECDC4;
}

headerbar entry,
.titlebar entry,
.searchbar-container entry,
GtkSearchBar entry,
headerbar GtkEntry {
  background-color: @theme_base_color;
  color: @theme_text_color;
  border-color: #445264;
}

entry:focus,
GtkEntry:focus {
  border-color: #4ECDC4;
}

entry placeholder {
  color: #B4BEC9;
}

entry:disabled {
  background-color: #161B22;
  color: #B4BEC9;
}

entry selection,
textview text selection,
.view selection {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

VteTerminal,
vte-terminal,
TerminalWindow,
.terminal,
console {
  background-color: @terminal_bg_color;
  color: @terminal_fg_color;
}

.card,
.card-view,
list.boxed-list {
  background-color: #252D38;
  color: @theme_fg_color;
  border-color: @borders;
}

button,
GtkButton {
  background-color: @theme_button_background_normal;
  /* GTK paints the base theme's gradient over background-color. */
  background-image: none;
  color: @theme_button_foreground_normal;
  border-color: @borders;
  text-shadow: none;
  -gtk-icon-shadow: none;
  box-shadow: none;
}

headerbar button,
.titlebar button {
  background-color: #252D38;
  color: @theme_fg_color;
  border-color: @borders;
}

button:hover {
  background-color: @theme_button_background_hover;
  border-color: #68D8D1;
}

button:active {
  background-color: #2FB6AE;
  color: #081411;
  border-color: #2FB6AE;
}

button:disabled {
  background-color: #161B22;
  color: #B4BEC9;
  border-color: @borders;
}

button.suggested-action,
button:checked {
  background-color: #4ECDC4;
  color: #081411;
  border-color: #4ECDC4;
}

/* Theme both switch nodes and clear the base theme's gradients. */
switch {
  background-color: #252D38;
  background-image: none;
  color: #B4BEC9;
  border-color: #445264;
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
}

switch slider {
  background-color: #B4BEC9;
  background-image: none;
  color: #252D38;
  border-color: transparent;
  box-shadow: none;
}

switch:hover {
  border-color: #68D8D1;
}

switch:checked {
  background-color: #4ECDC4;
  /* Keep the track from showing through the handle's antialiased edge. */
  background-clip: padding-box;
  color: #081411;
  border-color: transparent;
}

switch:checked:hover {
  background-color: #68D8D1;
  border-color: transparent;
}

switch:checked slider {
  background-color: @theme_fg_color;
  color: #4ECDC4;
}

switch:disabled {
  opacity: 0.5;
}

button.destructive-action {
  background-color: #E76F51;
  color: #081411;
  border-color: #E76F51;
}

.info {
  background-color: #4ECDC4;
  color: #081411;
}

.success {
  background-color: #57CC99;
  color: #081411;
}

.warning {
  background-color: #F4A261;
  color: #081411;
}

.error {
  background-color: #E76F51;
  color: #081411;
}

selection {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

a,
link {
  color: @link_color;
}

.dim-label,
.subtitle {
  color: #B4BEC9;
}

/* GTK 3.24 CSS nodes: https://docs.gtk.org/gtk3/css-overview.html
 * Recolor the base theme's surfaces, retaining its geometry and icon shapes.
 * An app can request Adwaita-dark even when the generated palette is light.
 */
notebook,
notebook > stack {
  background-color: @theme_bg_color;
  color: @theme_fg_color;
  border-color: @borders;
}

notebook > header {
  background-color: #1D232C;
  background-image: none;
  color: @theme_fg_color;
  border-color: @borders;
}

notebook > header > tabs > tab {
  background-color: transparent;
  background-image: none;
  color: @insensitive_fg_color;
  border-color: transparent;
  box-shadow: none;
}

notebook > header > tabs > tab:hover {
  background-color: #252D38;
  color: @theme_fg_color;
}

notebook > header > tabs > tab:checked {
  background-color: @theme_bg_color;
  color: @theme_fg_color;
}

notebook > header.top > tabs > tab:checked {
  box-shadow: inset 0 -2px #4ECDC4;
}

notebook > header.bottom > tabs > tab:checked {
  box-shadow: inset 0 2px #4ECDC4;
}

notebook > header.left > tabs > tab:checked {
  box-shadow: inset -2px 0 #4ECDC4;
}

notebook > header.right > tabs > tab:checked {
  box-shadow: inset 2px 0 #4ECDC4;
}

notebook > header > tabs > arrow {
  background-color: transparent;
  background-image: none;
  color: @theme_fg_color;
  border-color: transparent;
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
}

notebook > header > tabs > arrow:hover {
  background-color: #252D38;
}

/* Check/radio nodes are also used by menus and tree-view cell renderers. */
check,
radio {
  background-color: @theme_base_color;
  background-image: none;
  color: @theme_text_color;
  border-color: #B4BEC9;
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
}

check:hover,
radio:hover {
  border-color: #68D8D1;
}

check:checked,
check:indeterminate,
radio:checked,
radio:indeterminate {
  background-color: #4ECDC4;
  color: #081411;
  border-color: #4ECDC4;
}

spinbutton {
  background-color: @theme_entry_background;
  background-image: none;
  color: @theme_entry_foreground;
  border-color: @borders;
  box-shadow: none;
}

spinbutton:focus {
  border-color: #4ECDC4;
}

/* Do not recolor color chooser hue/alpha troughs: their gradients are data. */
scale,
progressbar {
  color: @theme_fg_color;
}

scale value,
scale marks,
progressbar text {
  color: @insensitive_fg_color;
}

scale marks indicator {
  background-color: @insensitive_fg_color;
  color: @insensitive_fg_color;
}

scale:not(.color) trough,
progressbar trough,
levelbar trough {
  background-color: @theme_base_color;
  background-image: none;
  border-color: @borders;
  box-shadow: none;
}

scale:not(.color) highlight,
progressbar progress,
entry progress {
  background-color: #4ECDC4;
  background-image: none;
  border-color: #4ECDC4;
  box-shadow: none;
}

scale:not(.color) fill {
  background-color: @theme_selected_bg_color;
  background-image: none;
  border-color: @borders;
}

scale:not(.color) slider {
  background-color: #4ECDC4;
  background-image: none;
  color: #081411;
  border-color: #4ECDC4;
  border-radius: 100%;
  box-shadow: none;
}

scale:not(.color) slider:hover {
  background-color: #68D8D1;
  border-color: #68D8D1;
}

scale:not(.color) slider:active {
  background-color: #2FB6AE;
  border-color: #2FB6AE;
}

scrollbar,
scrollbar trough,
scrolledwindow junction {
  background-color: @theme_bg_color;
  background-image: none;
  color: @theme_fg_color;
  border-color: @borders;
  box-shadow: none;
}

scrollbar slider {
  background-color: #B4BEC9;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}

scrollbar slider:hover,
scrollbar slider:active {
  background-color: #4ECDC4;
}

/* Retain scroll-edge feedback with palette-derived colors. */
scrolledwindow overshoot.top,
scrolledwindow undershoot.top {
  background-image: linear-gradient(to bottom, alpha(@theme_fg_color, 0.15), transparent);
}

scrolledwindow overshoot.bottom,
scrolledwindow undershoot.bottom {
  background-image: linear-gradient(to top, alpha(@theme_fg_color, 0.15), transparent);
}

scrolledwindow overshoot.left,
scrolledwindow undershoot.left {
  background-image: linear-gradient(to right, alpha(@theme_fg_color, 0.15), transparent);
}

scrolledwindow overshoot.right,
scrolledwindow undershoot.right {
  background-image: linear-gradient(to left, alpha(@theme_fg_color, 0.15), transparent);
}

levelbar block {
  background-color: #4ECDC4;
  background-image: none;
  border-color: #4ECDC4;
  color: #081411;
  box-shadow: none;
}

levelbar block.low {
  background-color: #F4A261;
  border-color: #F4A261;
}

levelbar block.high,
levelbar block.full {
  background-color: #57CC99;
  border-color: #57CC99;
}

levelbar block.empty {
  background-color: @theme_base_color;
  border-color: @borders;
  color: @theme_text_color;
}

frame > border,
.frame,
scrolledwindow {
  border-color: @borders;
}

separator,
paned > separator {
  background-color: @borders;
  background-image: none;
  color: @borders;
}

paned > separator:hover {
  background-color: #4ECDC4;
}

expander > title {
  color: @theme_fg_color;
}

expander > title > arrow {
  color: #B4BEC9;
}

expander > title > arrow:hover,
expander > title > arrow:checked {
  color: #4ECDC4;
}

calendar {
  background-color: @theme_base_color;
  color: @theme_text_color;
  border-color: @borders;
}

calendar.header {
  background-color: #1D232C;
  background-image: none;
  color: @theme_fg_color;
  border-color: @borders;
}

calendar.button {
  color: @theme_fg_color;
}

calendar.button:hover {
  color: #4ECDC4;
}

calendar.highlight {
  color: #4ECDC4;
}

calendar:selected {
  background-color: @theme_selected_bg_color;
  color: @theme_selected_fg_color;
}

calendar:indeterminate {
  color: @insensitive_fg_color;
}

rubberband {
  background-color: alpha(#4ECDC4, 0.2);
  border-color: #4ECDC4;
}

/* Semantic input errors remain inputs, rather than solid message banners. */
entry.error,
entry.warning {
  background-color: @theme_entry_background;
  color: @theme_entry_foreground;
}

entry.error { border-color: #E76F51; }
entry.warning { border-color: #F4A261; }

infobar,
infobar > revealer > box {
  background-color: #252D38;
  background-image: none;
  color: @theme_fg_color;
  border-color: @borders;
}

infobar.info,
infobar.info > revealer > box,
infobar.question,
infobar.question > revealer > box {
  background-color: #4ECDC4;
  color: #081411;
}

infobar.warning,
infobar.warning > revealer > box {
  background-color: #F4A261;
  color: #081411;
}

infobar.error,
infobar.error > revealer > box {
  background-color: #E76F51;
  color: #081411;
}

/* These nodes can carry base-theme foregrounds instead of inheriting. */
button label,
button image,
button arrow,
button cellview,
notebook tab label,
flowboxchild,
flowboxchild label,
infobar label {
  color: inherit;
}

spinner {
  color: @theme_fg_color;
}

button:link,
button:visited {
  background-color: transparent;
  color: @link_color;
}

label:disabled,
image:disabled,
checkbutton:disabled,
radiobutton:disabled,
expander > title:disabled,
expander > title > arrow:disabled,
notebook > header > tabs > tab:disabled,
notebook > header > tabs > arrow:disabled,
calendar:disabled,
scale value:disabled,
scale marks:disabled {
  color: @insensitive_fg_color;
}

button:disabled,
check:disabled,
radio:disabled,
spinbutton:disabled,
scale:not(.color) slider:disabled,
scale:not(.color) highlight:disabled {
  background-color: @insensitive_bg_color;
  color: @insensitive_fg_color;
  border-color: @borders;
}

check:checked:disabled,
check:indeterminate:disabled,
radio:checked:disabled,
radio:indeterminate:disabled,
scrollbar slider:disabled {
  background-color: #B4BEC9;
  color: @theme_bg_color;
}

*:focus {
  outline-color: #4ECDC4;
}
